# Skopiuj do pliku .env i uzupełnij danymi z Firebase Console
# (Ustawienia projektu → Ogólne → Twoje aplikacje → Aplikacja internetowa → Konfiguracja SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Adres Workera przypomnień (po `npm run worker:deploy`), np. https://planer-push.TWOJA-NAZWA.workers.dev
# Puste = aplikacja działa normalnie, tylko bez powiadomień push.
VITE_WORKER_URL=
