{
  "name": "planer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p tsconfig.sw.json",
    "icons": "pwa-assets-generator --preset minimal-2023 public/logo.svg",
    "test": "vitest run",
    "vapid": "node scripts/vapid.mjs",
    "worker:db": "wrangler d1 migrations apply planer --remote --config worker/wrangler.toml",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --port 8787 --test-scheduled",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "^15.36.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.161.0"
  }
}
